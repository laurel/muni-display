# Copy this file to secrets.yaml and fill it in. secrets.yaml stays on your Mac.
wifi_ssid: "YOUR_WIFI_NAME"
wifi_password: "YOUR_WIFI_PASSWORD"

# Your 511.org token goes in the middle of this URL.
api_511_url: "https://api.511.org/transit/StopMonitoring?api_key=YOUR_511_TOKEN&agency=SF&stopcode=15644&format=json"
